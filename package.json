{
  "name": "tato-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "tatorm.com — sito one-page statico (HTML/CSS/JS vanilla). Build con esbuild.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "catalog": "node scripts/fetch-catalog.mjs",
    "build": "node scripts/fetch-catalog.mjs && node scripts/build.mjs",
    "preview": "esbuild --servedir=_site --serve=127.0.0.1:8001",
    "images": "node scripts/images.mjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5"
  }
}
