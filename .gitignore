# macOS
.DS_Store
**/.DS_Store

# Foto scartate / non usate nel sito
archive/unused-photos/

# Export / bozze locali
*.numbers

# Toolchain
node_modules/

# Generati dal build (li produce la GitHub Action)
_site/
assets/dist/

# Originali immagini ad alta risoluzione (input di scripts/images.mjs)
media/_src/

# Materiale di riferimento/lavoro, non asset del sito (i file che servono
# davvero — packshot, font — sono già dentro media/ e assets/fonts/)
ESHOP/
SHOPIFY EXPORT/

# Documenti interni in PDF (non pubblicare)
docs/*.pdf
